#!/bin/bash
# post-commit hook: 커밋마다 log/changes.log에 변경 이력 자동 기록

# 무한 루프 방지 (로그 업데이트 커밋이 다시 훅을 호출하지 않도록)
if [ "${SKIP_LOG_UPDATE}" = "1" ]; then
    exit 0
fi

LOG_FILE="log/changes.log"
TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")
COMMIT_HASH=$(git log -1 --format="%h")
COMMIT_FULL=$(git log -1 --format="%H")
COMMIT_MSG=$(git log -1 --format="%s")
BRANCH=$(git rev-parse --abbrev-ref HEAD)
AUTHOR=$(git log -1 --format="%an <%ae>")

# 변경된 파일 목록 (상태코드 포함)
CHANGED=$(git diff-tree --no-commit-id -r --name-status HEAD 2>/dev/null \
    | awk '{printf "  %-2s %s\n", $1, $2}')

# 커밋 통계 (n files changed, n insertions, n deletions)
STATS=$(git show --stat HEAD 2>/dev/null | tail -1 | sed 's/^ *//')

mkdir -p "$(dirname "$LOG_FILE")"

cat >> "$LOG_FILE" <<EOF
┌─────────────────────────────────────────────┐
│ $TIMESTAMP
├─────────────────────────────────────────────┤
│ 커밋   : $COMMIT_HASH
│ 메시지 : $COMMIT_MSG
│ 브랜치 : $BRANCH
│ 작성자 : $AUTHOR
├─────────────────────────────────────────────┤
│ 변경된 파일
$CHANGED
│
│ $STATS
└─────────────────────────────────────────────┘

EOF

# 로그 파일이 변경된 경우에만 커밋
git add "$LOG_FILE"
if ! git diff --cached --quiet; then
    SKIP_LOG_UPDATE=1 git commit -m "chore: 변경 로그 업데이트 [$TIMESTAMP]"
fi

# 커밋 후 다음 세션이 Plan Mode로 시작되도록 설정
SETTINGS_FILE=".claude/settings.local.json"
if [ -f "$SETTINGS_FILE" ]; then
    _TMP_PY=$(mktemp /tmp/set_plan_mode_XXXXXX.py)
    cat > "$_TMP_PY" <<'PYEOF'
import json
f = ".claude/settings.local.json"
with open(f) as fp:
    data = json.load(fp)
data.setdefault("permissions", {})["defaultMode"] = "plan"
with open(f, "w") as fp:
    json.dump(data, fp, indent=2, ensure_ascii=False)
    fp.write("\n")
PYEOF
    python3 "$_TMP_PY"
    rm -f "$_TMP_PY"
fi

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  커밋 완료! Plan Mode로 전환되었습니다."
echo "  현재 세션: UI에서 Plan Mode 토글 필요"
echo "  다음 세션: 자동으로 Plan Mode 시작됨"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
